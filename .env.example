# GitHub API token (optional). Raises the unauthenticated rate limit and lets
# you analyze private repos you have access to. Create one at
# https://github.com/settings/tokens with no scopes (public repos) or "repo"
# scope (private repos).
GITHUB_TOKEN=

# Google Gemini API key (optional). Enables "Deep-Dive Agentic Insights" mode.
# Without it, the app still works fully in Normal mode — Deep-Dive just shows
# as disabled. Create a key at https://aistudio.google.com/apikey.
# Server-side only: never exposed to the client, never logged.
GOOGLE_API_KEY=
